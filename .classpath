<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" path="engine/catalog"/>
	<classpathentry excluding="events/" kind="src" path="engine/events"/>
	<classpathentry kind="src" path="engine/events/events"/>
	<classpathentry kind="src" path="engine/execution"/>
	<classpathentry excluding="bitmap/|hash/|btree/|rtree/" kind="src" path="engine/index"/>
	<classpathentry kind="src" path="engine/index/bitmap"/>
	<classpathentry kind="src" path="engine/index/btree"/>
	<classpathentry kind="src" path="engine/index/hash"/>
	<classpathentry kind="src" path="engine/index/rtree"/>
	<classpathentry kind="src" path="engine/optimizer"/>
	<classpathentry kind="src" path="engine/parser"/>
	<classpathentry kind="src" path="engine/record"/>
	<classpathentry kind="src" path="engine/storage"/>
	<classpathentry kind="src" path="ui/animation"/>
	<classpathentry kind="src" path="ui/app"/>
	<classpathentry kind="src" path="ui/components"/>
	<classpathentry kind="src" path="ui/controller"/>
	<classpathentry kind="src" path="ui/threading"/>
	<classpathentry kind="src" path="ui/visualizer"/>
	<classpathentry including="**/*.java" kind="src" output="target/classes" path="src">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
			<attribute name="optional" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
